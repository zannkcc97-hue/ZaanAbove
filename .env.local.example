# Supabase (Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-disini

# Google Gemini API key (dari https://aistudio.google.com/)
GEMINI_API_KEY=isi-api-key-gemini-disini

# Secret untuk menandatangani session login (bebas, string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
